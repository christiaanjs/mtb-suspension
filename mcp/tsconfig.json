{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["../*"] }
  },
  "include": ["src", "ui", "*.ts", "../lib/**/*.ts", "../components/**/*.tsx"],
  "exclude": ["../lib/**/*.test.ts", "node_modules"]
}
