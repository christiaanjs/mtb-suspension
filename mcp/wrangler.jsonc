{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtb-suspension-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  // Bundle the built single-file viewer as a text module.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "vars": {
    // Set to the deployed URL, e.g. https://mtb-suspension-mcp.<you>.workers.dev/mcp
    // (used to compute Claude's ui.domain). Leave unset for local dev.
    // "PUBLIC_MCP_URL": "https://..."
  },
  // Per-IP rate limit (free; not billed per request). `period` must be 10 or 60.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
